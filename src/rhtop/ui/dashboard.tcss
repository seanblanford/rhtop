Screen {
    background: #0c1014;
    color: #d4dce3;
}
#header {
    height: 1;
    margin: 0;
    padding: 0;
}
#topline {
    width: 1fr;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#workspace {
    height: 1fr;
    margin: 0;
    layout: grid;
    grid-size: 2 2;
    grid-columns: 29 1fr;
    grid-rows: 3fr 2fr;
    grid-gutter: 0;
    overflow-y: auto;
}
.panel {
    border: round #3a4b55;
    border-title-color: #8a959e;
    padding: 0;
    min-width: 0;
    min-height: 5;
}
.panel:focus-within {
    border: round #7dd3a8;
    border-title-color: #7dd3a8;
}
#account { row-span: 2; }
#account-content { height: auto; }
#positions, #orders { height: 1fr; }
DataTable {
    background: #0c1014;
    height: 1fr;
    scrollbar-size: 1 1;
}
DataTable > .datatable--header {
    background: #141c22;
    color: #8a959e;
    text-style: none;
}
DataTable > .datatable--cursor {
    background: #21342f;
    color: #d4dce3;
}
DataTable > .datatable--hover { background: #1b272e; }
.empty { height: auto; color: #8a959e; padding: 0; }
#filter { height: 1; margin: 0; padding: 0; border: none; }
#status {
    width: auto;
    max-width: 50%;
    height: 1;
    margin: 0;
    padding: 0;
    color: #8a959e;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#clock {
    width: auto;
    height: 1;
    margin-left: 1;
    color: #8a959e;
    text-align: right;
    text-wrap: nowrap;
}
Footer { height: 1; background: #141c22; margin: 0; padding: 0; }
Footer > .footer--key { background: #21342f; color: #7dd3a8; }
FooterKey > .footer-key--key { padding: 0; }
FooterKey > .footer-key--description { padding: 0 0 0 1; }
ModalScreen { align: center middle; background: #000000 55%; }
#dialog {
    width: 76;
    max-width: 94%;
    height: auto;
    max-height: 85%;
    border: round #7dd3a8;
    padding: 0 1;
    background: #10171c;
}
#dialog VerticalScroll { height: auto; max-height: 24; }
.dialog-title { color: #7dd3a8; text-style: bold; margin: 0; }
.dialog-hint { color: #8a959e; margin: 0; }
#dialog OptionList { height: auto; max-height: 15; background: #10171c; padding: 0; border: none; }
#dialog.authorization { width: 90; padding: 0 1; }
#auth-url { height: 5; }
#auth-actions { height: 1; }
#auth-actions Button { width: auto; min-width: 14; height: 1; margin-right: 1; }
#auth-copy-note { height: auto; max-height: 2; color: #e9bd73; }
AssetPicker Select { height: 1; margin: 0; padding: 0; }
AssetPicker SelectCurrent { height: 1; padding: 0; }
AssetPicker SelectOverlay { padding: 0; }
Watchlists Select, Watchlists SelectCurrent { height: 1; margin: 0; padding: 0; }
Watchlists SelectOverlay { padding: 0; }
#watchlist-status { height: auto; max-height: 4; color: #8a959e; }
#watchlist-items { height: 1fr; min-height: 2; padding: 0; border: none; background: #0c1014; }
#asset-query { height: 1; margin: 0; padding: 0; border: none; }
#asset-status { height: auto; max-height: 4; color: #8a959e; margin: 0; }
#asset-results { height: 1fr; min-height: 2; background: #0c1014; border: none; padding: 0; }
#asset-recents { height: 1fr; max-height: 10; min-height: 2; background: #0c1014; border: none; padding: 0; }
#asset-results, #asset-recents { text-wrap: nowrap; text-overflow: ellipsis; }
#recent-label { height: 1; color: #7dd3a8; margin: 0; }
